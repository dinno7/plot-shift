# Copy to .env. load_dotenv() reads .env from the project root.

# Required for `plot-shift download-subs`.
OPEN_SUBTITLE_API_KEY=
OPEN_SUBTITLE_USER_AGENT=
OPEN_SUBTITLE_USERNAME=
OPEN_SUBTITLE_PASSWORD=

# Required for `plot-shift score-model --model jev`.
# The SDK sends this key on every request. A local server can ignore it.
TYPESAFE_API_KEY=

# Optional Jev settings. Uncomment to override the default.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0
# TYPESAFE_TIMEOUT=10
# TYPESAFE_LOG_LEVEL=info
